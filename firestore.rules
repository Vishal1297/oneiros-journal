rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && (
        request.resource.data.keys().hasAll(['email', 'displayName', 'photoURL']) &&
        request.resource.data.email is string &&
        request.resource.data.displayName is string
      );
    }

    // --- Dreams ---
    match /dreams/{dreamId} {
      function isValidDream(data) {
        return data.userId == request.auth.uid &&
               data.transcription is string && data.transcription.size() <= 10000 &&
               (data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 1048576)) &&
               (data.interpretation == null || data.interpretation is string) &&
               (data.emotionalTheme == null || data.emotionalTheme is string) &&
               (data.symbols == null || data.symbols is list) &&
               data.timestamp != null;
      }

      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && 
                      isValidDream(request.resource.data) &&
                      request.resource.data.keys().hasAll(['userId', 'timestamp', 'transcription']);
      
      allow update: if isSignedIn() && 
                      resource.data.userId == request.auth.uid &&
                      isValidDream(request.resource.data) &&
                      request.resource.data.userId == resource.data.userId &&
                      // Explicitly allowed update paths (e.g. chat history)
                      (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chatHistory']) ||
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['imageUrl', 'interpretation', 'emotionalTheme', 'symbols', 'chatHistory'])
                      );
                      
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
