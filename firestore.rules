rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && (
        request.resource.data.keys().hasAll(['email', 'displayName', 'photoURL']) &&
        request.resource.data.email is string &&
        request.resource.data.displayName is string
      );
    }

    // --- Dreams ---
    match /dreams/{dreamId} {
      function isValidDream(data) {
        return data.userId == request.auth.uid &&
               data.transcription is string && data.transcription.size() <= 10000 &&
               (!('imageUrl' in data) || data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 600000)) &&
               (!('interpretation' in data) || data.interpretation == null || data.interpretation is string) &&
               (!('emotionalTheme' in data) || data.emotionalTheme == null || data.emotionalTheme is string) &&
               (!('symbols' in data) || data.symbols == null || data.symbols is list) &&
               (!('status' in data) || data.status in ['analyzing', 'visualizing', 'complete', 'error']) &&
               (!('chatHistory' in data) || data.chatHistory is list && data.chatHistory.size() <= 100);
      }

      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && 
                      isValidDream(request.resource.data) &&
                      request.resource.data.timestamp == request.time &&
                      request.resource.data.keys().hasAll(['userId', 'timestamp', 'transcription', 'chatHistory', 'status']) &&
                      request.resource.data.keys().size() == 5;
      
      allow update: if isSignedIn() && 
                      resource.data.userId == request.auth.uid &&
                      isValidDream(request.resource.data) &&
                      request.resource.data.userId == resource.data.userId &&
                      request.resource.data.timestamp == resource.data.timestamp &&
                      (
                        // Chat update
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chatHistory']) ||
                        // Analysis update
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emotionalTheme', 'symbols', 'interpretation', 'status']) ||
                        // Image update
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['imageUrl', 'status']) ||
                        // Comprehensive update (if needed)
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['imageUrl', 'interpretation', 'emotionalTheme', 'symbols', 'chatHistory', 'status'])
                      );
                      
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
